# VC VFX desktop — build-time configuration.
# Copy to .env in this directory. The URL and anon key are public (the anon key
# is bound by row level security); the service role key must never appear here.
#
# Leave the Supabase values empty to build an offline app: it opens handoffs and
# projects, browses, verifies sources and prints, in read-only licence mode, and
# the Account dialog explains why sign-in is unavailable.

MAIN_VITE_SUPABASE_URL=
MAIN_VITE_SUPABASE_ANON_KEY=
MAIN_VITE_SITE_URL=https://vc-vfx.com
