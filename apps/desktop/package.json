{
  "name": "@vcvfx/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "VC VFX desktop application for Windows 10/11 and macOS",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:preview": "vite build --config vite.preview.config.ts",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "fetch:ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "fetch:onnxruntime": "node scripts/fetch-onnxruntime.mjs",
    "package:win": "node scripts/fetch-ffmpeg.mjs win32-x64 && node scripts/fetch-onnxruntime.mjs win32-x64 && electron-vite build && electron-builder --win --publish never",
    "package:mac": "node scripts/fetch-ffmpeg.mjs darwin-arm64 darwin-x64 && node scripts/fetch-onnxruntime.mjs darwin-arm64 darwin-x64 && electron-vite build && electron-builder --mac --publish never"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "@vcvfx/domain": "workspace:*",
    "xxhash-wasm": "^1.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.134.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.4"
  }
}
