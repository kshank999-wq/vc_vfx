{
  "name": "@vcvfx/web",
  "version": "0.1.0",
  "private": true,
  "description": "vc-vfx.com: marketing site, accounts, Stripe checkout, licence delivery and installer downloads",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm --filter @vcvfx/domain build && pnpm run build:preview && next build",
    "build:preview": "node scripts/build-preview.mjs",
    "start": "next start",
    "typecheck": "pnpm --filter @vcvfx/domain build && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.134.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.46.1",
    "@vcvfx/domain": "workspace:*",
    "next": "^14.2.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^4.0.1",
    "stripe": "^17.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "playwright-core": "^1.56.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
