# vc-vfx.com environment. Every value is read lazily: the site builds and the
# marketing pages render with none of these set. Copy to .env.local for local
# development; set them in Vercel (Project > Settings > Environment Variables)
# for production. Never commit real values.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses row level security.
SUPABASE_SERVICE_ROLE_KEY=

# The site's own origin, no trailing slash. Defaults to https://vc-vfx.com.
NEXT_PUBLIC_SITE_URL=

# Stripe (Developers > API keys, and the webhook endpoint's signing secret)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring prices on the "VC VFX" product
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_YEARLY=

# Resend (transactional email: licence delivery)
RESEND_API_KEY=
# Defaults to "VC VFX <noreply@vc-vfx.com>"
RESEND_FROM_ADDRESS=

# Installers live in this private Supabase Storage bucket. Defaults to "releases".
RELEASE_BUCKET=
# Lifetime of a signed download URL, in seconds. Defaults to 900.
RELEASE_DOWNLOAD_TTL_SECONDS=

# Before launch everyone but admins sees /coming-soon. Set to true to open the site.
SITE_LAUNCHED=
