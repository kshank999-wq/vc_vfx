{
  "name": "vcvfx",
  "version": "0.1.0",
  "private": true,
  "description": "VC VFX — independent-production VFX preparation, automation and handoff system",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev:desktop": "pnpm --filter @vcvfx/desktop dev",
    "dev:web": "pnpm --filter @vcvfx/web dev"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "electron"
    ]
  }
}
